# =============================================================================
# Gluten + Velox Backend Build Environment
# =============================================================================
# Target platform : linux/arm64 (AWS Graviton / aarch64)
# Base OS         : Ubuntu 22.04
# JDK             : OpenJDK 17 (apache-rat-plugin 0.18 requires Java 17+)
# CMake           : 3.30.4 (Velox requires 3.28+; Ubuntu 22.04 ships 3.22)
# Scala           : 2.12
# Spark           : 3.5.8 ONLY
#
# Strategy: install only the packages NOT handled by Velox's setup-ubuntu.sh,
# then pass --run_setup_script=ON so Velox installs its own deps (including
# Folly which it builds via FetchContent, fizz, fbthrift, arrow, etc).
# =============================================================================

ARG TARGETPLATFORM=linux/arm64
FROM --platform=$TARGETPLATFORM ubuntu:22.04

LABEL maintainer="gluten-velox-dev"
LABEL description="Gluten + Velox build env (ARM64/Graviton, Spark 3.5.8)"
LABEL target.arch="arm64"
LABEL spark.versions="3.5.8"
LABEL jdk.version="openjdk17"
LABEL cmake.version="3.30.4"
LABEL scala.version="2.12"

ENV DEBIAN_FRONTEND=noninteractive
ENV TZ=UTC

# ---------------------------------------------------------------------------
# Build arguments
# ---------------------------------------------------------------------------
ARG NUM_THREADS=4
ARG CMAKE_VERSION=3.30.4
ARG MAVEN_VERSION=3.9.6

# ---------------------------------------------------------------------------
# Java 17 — required by apache-rat-plugin 0.18 (class file 61.0)
# Spark 3.5 fully supports Java 17.
# ---------------------------------------------------------------------------
ENV JAVA_HOME=/usr/lib/jvm/java-17-openjdk-arm64
ENV PATH=${JAVA_HOME}/bin:${PATH}

# ---------------------------------------------------------------------------
# Maven
# ---------------------------------------------------------------------------
ENV MAVEN_HOME=/opt/maven
ENV PATH=${MAVEN_HOME}/bin:${PATH}

# ---------------------------------------------------------------------------
# Gluten workspace
# ---------------------------------------------------------------------------
ENV GLUTEN_HOME=/gluten
WORKDIR ${GLUTEN_HOME}

# ---------------------------------------------------------------------------
# Step 1 — Minimal system packages needed before Velox's setup script runs
#
# We only install what Velox's setup-ubuntu.sh does NOT handle:
#   - sudo (needed by the setup script itself)
#   - openjdk-17 (needed by Maven/Gluten, not a Velox dep)
#   - openjdk-8 (fallback JDK)
#   - python3/pip/venv (needed by Gluten's check.py and uv install)
#   - curl/wget/git (needed to fetch sources)
#   - Maven prerequisites
#   - Boost (Gluten CPP uses system Boost; Velox uses its own internal copy)
#
# Everything else (glog, gflags, gtest, re2, lz4, zstd, folly, arrow, etc.)
# is handled by Velox's setup-ubuntu.sh via --run_setup_script=ON.
# ---------------------------------------------------------------------------
RUN apt-get update -y && \
    apt-get install -y --no-install-recommends \
      sudo \
      build-essential \
      git \
      curl \
      wget \
      unzip \
      tar \
      patch \
      python3 \
      python3-pip \
      python3-venv \
      openjdk-17-jdk \
      openjdk-8-jdk \
      libboost-all-dev \
      tzdata \
    && rm -rf /var/lib/apt/lists/*

# ---------------------------------------------------------------------------
# Step 2 — Python packages
# ---------------------------------------------------------------------------
RUN pip3 install --no-cache-dir regex uv

# ---------------------------------------------------------------------------
# Step 3 — CMake 3.30.4 (Ubuntu 22.04 ships 3.22 — Velox needs 3.28+)
#   Velox's setup-ubuntu.sh installs cmake via:  uv_install cmake==3.30.4
#   We replicate that here using the official cmake binary for aarch64.
# ---------------------------------------------------------------------------
RUN CMAKE_VERSION=${CMAKE_VERSION} && \
    wget -q "https://github.com/Kitware/CMake/releases/download/v${CMAKE_VERSION}/cmake-${CMAKE_VERSION}-linux-aarch64.sh" \
         -O /tmp/cmake-install.sh && \
    chmod +x /tmp/cmake-install.sh && \
    /tmp/cmake-install.sh --prefix=/usr/local --skip-license && \
    rm /tmp/cmake-install.sh && \
    cmake --version

# ---------------------------------------------------------------------------
# Step 4 — Apache Maven 3.9.6
# ---------------------------------------------------------------------------
RUN wget -q "https://archive.apache.org/dist/maven/maven-3/${MAVEN_VERSION}/binaries/apache-maven-${MAVEN_VERSION}-bin.tar.gz" \
         -O /tmp/maven.tar.gz && \
    tar -xzf /tmp/maven.tar.gz -C /opt && \
    ln -s /opt/apache-maven-${MAVEN_VERSION} ${MAVEN_HOME} && \
    rm /tmp/maven.tar.gz && \
    mvn -version

# ---------------------------------------------------------------------------
# Step 5 — Set Java 17 as default
# ---------------------------------------------------------------------------
RUN update-alternatives --set java /usr/lib/jvm/java-17-openjdk-arm64/bin/java || true
ENV JAVA_HOME=/usr/lib/jvm/java-17-openjdk-arm64
ENV PATH=${JAVA_HOME}/bin:${PATH}
RUN java -version && cmake --version

# ---------------------------------------------------------------------------
# Step 6 — Copy Gluten-Velox source
#   When running via docker-build.sh the source is bind-mounted at runtime.
#   This COPY is for self-contained CI builds (docker build → docker push).
# ---------------------------------------------------------------------------
COPY . ${GLUTEN_HOME}/
RUN find ${GLUTEN_HOME} -name "*.sh" -exec chmod +x {} \; 2>/dev/null || true

# ---------------------------------------------------------------------------
# Step 7 — Build environment variables
# ---------------------------------------------------------------------------
ENV NUM_THREADS=${NUM_THREADS}
ENV SPARK_VERSION=3.5
ENV CPU_TARGET=aarch64

# ---------------------------------------------------------------------------
# Step 8 — Default CMD
#   --run_setup_script=ON : let Velox's setup-ubuntu.sh install its own deps
#   (Folly, fizz, fbthrift, arrow, re2, glog, gflags, etc. are all handled
#    by Velox's setup script — we must NOT try to pre-install them)
# ---------------------------------------------------------------------------
CMD ["/bin/bash", "-c", \
     "set -e && \
      echo '=====================================================' && \
      echo ' Gluten + Velox Backend Builder (ARM64 / Graviton)' && \
      echo ' Arch          : '$(uname -m) && \
      echo ' Spark version : 3.5.8  (profile: spark-3.5)' && \
      echo ' Threads       : '${NUM_THREADS} && \
      echo ' Java home     : '${JAVA_HOME} && \
      echo ' CMake         : '$(cmake --version | head -1) && \
      echo '=====================================================' && \
      cd ${GLUTEN_HOME} && \
      export NUM_THREADS=${NUM_THREADS} && \
      export CPU_TARGET=aarch64 && \
      ./dev/buildbundle-veloxbe.sh \
        --spark_version=3.5 \
        --run_setup_script=ON && \
      echo '' && \
      echo '=====================================================' && \
      echo ' BUILD COMPLETE! Copying JARs to /output ...' && \
      find ${GLUTEN_HOME}/package/target/ -name '*.jar' \
        ! -name '*sources*' ! -name '*javadoc*' \
        -exec cp -v {} /output/ \\; 2>/dev/null || true && \
      ls -lh /output/*.jar 2>/dev/null || echo 'No JARs found in /output' && \
      echo '=====================================================' \
     "]
