# =============================================================================
# Gluten + Velox Backend Build Environment — COMPREHENSIVE
# =============================================================================
# Target platform : linux/arm64 (AWS Graviton / aarch64)
# Base OS         : Ubuntu 22.04
# JDK             : OpenJDK 17 (apache-rat-plugin 0.18 requires Java 17+)
# CMake           : 3.30.4 (Velox requires 3.28+; Ubuntu 22.04 ships 3.22)
# Scala           : 2.12
# Spark           : 3.5.8 ONLY
#
# All dependencies are pre-installed here so that:
#   --run_setup_script=OFF  can be passed to buildbundle-veloxbe.sh
# This avoids Velox's setup script trying to apt-install inside the container.
# =============================================================================

ARG TARGETPLATFORM=linux/arm64
FROM --platform=$TARGETPLATFORM ubuntu:22.04

LABEL maintainer="gluten-velox-dev"
LABEL description="Gluten + Velox build env (ARM64/Graviton, Spark 3.5.8)"
LABEL target.arch="arm64"
LABEL spark.versions="3.5.8"
LABEL jdk.version="openjdk17"
LABEL cmake.version="3.30.4"
LABEL scala.version="2.12"

ENV DEBIAN_FRONTEND=noninteractive
ENV TZ=UTC

# ---------------------------------------------------------------------------
# Build arguments
# ---------------------------------------------------------------------------
ARG NUM_THREADS=4
ARG CMAKE_VERSION=3.30.4
ARG MAVEN_VERSION=3.9.6

# ---------------------------------------------------------------------------
# Java 17 — required by apache-rat-plugin 0.18 (class file 61.0)
# Spark 3.5 fully supports Java 17.
# ---------------------------------------------------------------------------
ENV JAVA_HOME=/usr/lib/jvm/java-17-openjdk-arm64
ENV PATH=${JAVA_HOME}/bin:${PATH}

# ---------------------------------------------------------------------------
# Maven
# ---------------------------------------------------------------------------
ENV MAVEN_HOME=/opt/maven
ENV PATH=${MAVEN_HOME}/bin:${PATH}

# ---------------------------------------------------------------------------
# Gluten workspace
# ---------------------------------------------------------------------------
ENV GLUTEN_HOME=/gluten
WORKDIR ${GLUTEN_HOME}

# ---------------------------------------------------------------------------
# Step 1 — System packages (exact list from Velox's setup-ubuntu.sh)
#
# Sources:
#   install_build_prerequisites()  → build-essential, ccache, ninja, git, etc.
#   install_velox_deps_from_apt()  → libc-ares, libssl, glog, gflags, etc.
#   setup-ubuntu.sh SVE check      → gcc-12, g++-12
#   Arrow build                    → libprotobuf-dev, protobuf-compiler
#   Gluten                         → sudo, clang-format-15, openjdk-17
# ---------------------------------------------------------------------------
RUN apt-get update -y && \
    apt-get install -y --no-install-recommends \
      # sudo — needed by Velox scripts (get-velox.sh, setup-ubuntu.sh)
      sudo \
      # Core build toolchain
      build-essential \
      gcc \
      g++ \
      gcc-12 \
      g++-12 \
      clang-15 \
      clang-format-15 \
      git \
      ninja-build \
      ccache \
      pkg-config \
      libtool \
      checkinstall \
      # Python (Gluten check.py + uv for cmake install)
      python3 \
      python3-pip \
      python3-venv \
      curl \
      wget \
      unzip \
      tar \
      patch \
      # JDKs
      openjdk-17-jdk \
      openjdk-8-jdk \
      # -----------------------------------------------------------------------
      # Velox deps from apt (install_velox_deps_from_apt in setup-ubuntu.sh)
      # -----------------------------------------------------------------------
      libc-ares-dev \
      libcurl4-openssl-dev \
      libssl-dev \
      libicu-dev \
      libdouble-conversion-dev \
      libgoogle-glog-dev \
      libbz2-dev \
      libgflags-dev \
      libgtest-dev \
      libgmock-dev \
      libevent-dev \
      liblz4-dev \
      libzstd-dev \
      libre2-dev \
      libsnappy-dev \
      libsodium-dev \
      libelf-dev \
      libdwarf-dev \
      libunwind-dev \
      bison \
      flex \
      libfl-dev \
      tzdata \
      libxxhash-dev \
      libxml2-dev \
      # Boost — required by Gluten CPP (core/CMakeLists.txt: find_package(Boost))
      # Velox uses its own internal Boost via FetchContent, no conflict here.
      libboost-all-dev \
      # Folly — required by Velox (velox/CMakeLists.txt: find_package(Folly))
      # Velox looks for FollyConfig.cmake; we build Folly from source after fetching it.
      libfolly-dev \
      # NOTE: do NOT install libprotobuf-dev or protobuf-compiler here!
      # Velox and Arrow build their own bundled protobuf.
      # System protobuf conflicts with Velox's ORC pre-generated pb.h headers
      # which use removed protobuf 3.x APIs (UnsafeArenaRelease, PROTOBUF_ULONGLONG).
      # zlib
      zlib1g-dev \
      # autotools (some thirdparty builds with autoconf)
      autoconf \
      automake \
    && rm -rf /var/lib/apt/lists/*

# ---------------------------------------------------------------------------
# Step 2 — Python packages
# ---------------------------------------------------------------------------
RUN pip3 install --no-cache-dir regex uv

# ---------------------------------------------------------------------------
# Step 3 — CMake 3.30.4 (Ubuntu 22.04 ships 3.22 — Velox needs 3.28+)
#   Velox's setup-ubuntu.sh installs cmake via:  uv_install cmake==3.30.4
#   We replicate that here using the official cmake binary for aarch64.
# ---------------------------------------------------------------------------
RUN CMAKE_VERSION=${CMAKE_VERSION} && \
    wget -q "https://github.com/Kitware/CMake/releases/download/v${CMAKE_VERSION}/cmake-${CMAKE_VERSION}-linux-aarch64.sh" \
         -O /tmp/cmake-install.sh && \
    chmod +x /tmp/cmake-install.sh && \
    /tmp/cmake-install.sh --prefix=/usr/local --skip-license && \
    rm /tmp/cmake-install.sh && \
    cmake --version

# ---------------------------------------------------------------------------
# Step 4 — Apache Maven 3.9.6
# ---------------------------------------------------------------------------
RUN wget -q "https://archive.apache.org/dist/maven/maven-3/${MAVEN_VERSION}/binaries/apache-maven-${MAVEN_VERSION}-bin.tar.gz" \
         -O /tmp/maven.tar.gz && \
    tar -xzf /tmp/maven.tar.gz -C /opt && \
    ln -s /opt/apache-maven-${MAVEN_VERSION} ${MAVEN_HOME} && \
    rm /tmp/maven.tar.gz && \
    mvn -version

# ---------------------------------------------------------------------------
# Step 5 — Set Java 17 as default
# ---------------------------------------------------------------------------
RUN update-alternatives --set java /usr/lib/jvm/java-17-openjdk-arm64/bin/java || true
ENV JAVA_HOME=/usr/lib/jvm/java-17-openjdk-arm64
ENV PATH=${JAVA_HOME}/bin:${PATH}
RUN java -version && cmake --version

# ---------------------------------------------------------------------------
# Step 6 — Copy Gluten-Velox source
#   When running via docker-build.sh the source is bind-mounted at runtime.
#   This COPY is for self-contained CI builds (docker build → docker push).
# ---------------------------------------------------------------------------
COPY . ${GLUTEN_HOME}/
RUN find ${GLUTEN_HOME} -name "*.sh" -exec chmod +x {} \; 2>/dev/null || true

# ---------------------------------------------------------------------------
# Step 7 — Build environment variables
# ---------------------------------------------------------------------------
ENV NUM_THREADS=${NUM_THREADS}
ENV SPARK_VERSION=3.5
ENV CPU_TARGET=aarch64

# ---------------------------------------------------------------------------
# Step 8 — Default CMD
#   --run_setup_script=OFF : skip Velox's apt installs — we did them above
# ---------------------------------------------------------------------------
CMD ["/bin/bash", "-c", \
     "set -e && \
      echo '=====================================================' && \
      echo ' Gluten + Velox Backend Builder (ARM64 / Graviton)' && \
      echo ' Arch          : '$(uname -m) && \
      echo ' Spark version : 3.5.8  (profile: spark-3.5)' && \
      echo ' Threads       : '${NUM_THREADS} && \
      echo ' Java home     : '${JAVA_HOME} && \
      echo ' CMake         : '$(cmake --version | head -1) && \
      echo '=====================================================' && \
      cd ${GLUTEN_HOME} && \
      export NUM_THREADS=${NUM_THREADS} && \
      export CPU_TARGET=aarch64 && \
      ./dev/buildbundle-veloxbe.sh \
        --spark_version=3.5 \
        --run_setup_script=OFF && \
      echo '' && \
      echo '=====================================================' && \
      echo ' BUILD COMPLETE! (Spark 3.5.8)' && \
      echo ' Jar: '${GLUTEN_HOME}/package/target/ && \
      ls -lh ${GLUTEN_HOME}/package/target/*.jar 2>/dev/null || true && \
      echo '=====================================================' \
     "]
