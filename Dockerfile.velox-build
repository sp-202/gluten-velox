# =============================================================================
# TWO-STAGE BUILD
# =============================================================================
#
# Stage 1 — gluten-velox-base  (~90 min, build once)
#   Clones IBM/velox, runs setup-ubuntu.sh, builds Velox + Arrow.
#   Tag: gluten-velox-base:arm64
#   Rebuild only when: Velox branch changes, or OS/tool versions change.
#
# Stage 2 — gluten-velox-builder  (~5 min, rebuild on every code change)
#   FROM gluten-velox-base. Copies Gluten source, builds Gluten CPP + Maven JAR.
#   Tag: gluten-velox-builder:arm64
#   Rebuild on: any Gluten source change.
#
# docker-build.sh builds Stage 1 with --rebuild-base, Stage 2 always.
# =============================================================================

ARG TARGETPLATFORM=linux/arm64
ARG NUM_THREADS=16
ARG CMAKE_VERSION=3.30.4
ARG MAVEN_VERSION=3.9.6

# =============================================================================
# STAGE 1 — velox-base: all slow deps baked in
# =============================================================================
FROM --platform=$TARGETPLATFORM ubuntu:22.04 AS velox-base

LABEL maintainer="gluten-velox-dev"
LABEL stage="velox-base"
LABEL description="Velox + Arrow pre-built base (ARM64/Graviton)"

ENV DEBIAN_FRONTEND=noninteractive
ENV TZ=UTC

ARG NUM_THREADS=4
ARG CMAKE_VERSION=3.30.4
ARG MAVEN_VERSION=3.9.6

ENV JAVA_HOME=/usr/lib/jvm/java-17-openjdk-arm64
ENV MAVEN_HOME=/opt/maven
ENV PATH=${JAVA_HOME}/bin:${MAVEN_HOME}/bin:/usr/local/bin:${PATH}
ENV GLUTEN_HOME=/gluten
ENV VELOX_HOME=/gluten/ep/build-velox/build/velox_ep

WORKDIR ${GLUTEN_HOME}

# ---------------------------------------------------------------------------
# Step 1 — System packages
# ---------------------------------------------------------------------------
RUN apt-get update -y && \
    apt-get install -y --no-install-recommends \
      sudo \
      build-essential \
      gcc \
      g++ \
      gcc-12 \
      g++-12 \
      git \
      curl \
      wget \
      unzip \
      tar \
      patch \
      ninja-build \
      ccache \
      pkg-config \
      libtool \
      autoconf \
      automake \
      bison \
      flex \
      python3 \
      python3-pip \
      python3-venv \
      openjdk-17-jdk \
      openjdk-8-jdk \
      libboost-all-dev \
      libgeos-dev \
      libgoogle-glog-dev \
      tzdata \
    && (apt-get remove -y libgflags-dev || true) \
    && rm -rf /var/lib/apt/lists/*

# ---------------------------------------------------------------------------
# Step 2 — Python packages (uv needed by Velox setup script)
# ---------------------------------------------------------------------------
RUN pip3 install --no-cache-dir regex uv

# ---------------------------------------------------------------------------
# Step 3 — CMake 3.30.4
# ---------------------------------------------------------------------------
RUN wget -q "https://github.com/Kitware/CMake/releases/download/v${CMAKE_VERSION}/cmake-${CMAKE_VERSION}-linux-aarch64.sh" \
         -O /tmp/cmake-install.sh && \
    chmod +x /tmp/cmake-install.sh && \
    /tmp/cmake-install.sh --prefix=/usr/local --skip-license && \
    rm /tmp/cmake-install.sh

# ---------------------------------------------------------------------------
# Step 4 — Apache Maven
# ---------------------------------------------------------------------------
RUN wget -q "https://archive.apache.org/dist/maven/maven-3/${MAVEN_VERSION}/binaries/apache-maven-${MAVEN_VERSION}-bin.tar.gz" \
         -O /tmp/maven.tar.gz && \
    tar -xzf /tmp/maven.tar.gz -C /opt && \
    ln -s /opt/apache-maven-${MAVEN_VERSION} ${MAVEN_HOME} && \
    rm /tmp/maven.tar.gz

# ---------------------------------------------------------------------------
# Step 5 — Set Java 17 as default
# ---------------------------------------------------------------------------
RUN update-alternatives --set java /usr/lib/jvm/java-17-openjdk-arm64/bin/java || true
RUN java -version && cmake --version && mvn -version

# ---------------------------------------------------------------------------
# Step 6 — Copy only the files needed to fetch + build Velox and Arrow.
#   We copy the ep/ and dev/ directories — NOT the full Gluten source.
#   This way changes to Gluten Java/CPP source don't invalidate this layer.
# ---------------------------------------------------------------------------
COPY ep/ ${GLUTEN_HOME}/ep/
COPY dev/ ${GLUTEN_HOME}/dev/
RUN find ${GLUTEN_HOME} -name "*.sh" -exec chmod +x {} \; 2>/dev/null || true

# ---------------------------------------------------------------------------
# Step 7 — Clone Velox, run its setup script, build Velox + Arrow.
#   This is the slow step (~90 min). Cached forever unless ep/ or dev/ changes.
# ---------------------------------------------------------------------------
ENV NUM_THREADS=${NUM_THREADS}
ENV CPU_TARGET=aarch64

RUN apt-get update -y && \
    cd ${GLUTEN_HOME} && \
    export NUM_THREADS=${NUM_THREADS} && \
    export CPU_TARGET=aarch64 && \
    export VELOX_HOME=${VELOX_HOME} && \
    # Run only: get_velox + setup_dependencies + build_arrow + build_velox
    # (not build_gluten_cpp — that needs full Gluten source in Stage 2)
    ./dev/builddeps-veloxbe.sh \
      --run_setup_script=ON \
      build_arrow \
      build_velox && \
    # Clean build artifacts that aren't needed at runtime to shrink image size
    find ${VELOX_HOME}/_build -name "*.o" -delete 2>/dev/null || true && \
    apt-get clean && rm -rf /var/lib/apt/lists/*

# =============================================================================
# STAGE 2 — gluten-velox-builder: fast Gluten source build on top of base
# =============================================================================
FROM velox-base AS gluten-velox-builder

LABEL stage="gluten-velox-builder"
LABEL description="Gluten + Velox final build (ARM64/Graviton, Spark 3.5.8)"

ARG NUM_THREADS=16
ENV NUM_THREADS=${NUM_THREADS}

# ---------------------------------------------------------------------------
# Copy full Gluten source — only this layer reruns on source changes
# ---------------------------------------------------------------------------
COPY . ${GLUTEN_HOME}/
RUN find ${GLUTEN_HOME} -name "*.sh" -exec chmod +x {} \; 2>/dev/null || true

# ---------------------------------------------------------------------------
# Default CMD — builds only Gluten CPP + Maven JAR (~5 min)
# ---------------------------------------------------------------------------
CMD ["/bin/bash", "-c", \
     "set -e && \
      echo '=====================================================' && \
      echo ' Gluten + Velox Backend Builder (ARM64 / Graviton)' && \
      echo ' Arch          : '$(uname -m) && \
      echo ' Spark version : 3.5.8  (profile: spark-3.5)' && \
      echo ' Threads       : '${NUM_THREADS} && \
      echo ' Java home     : '${JAVA_HOME} && \
      echo ' CMake         : '$(cmake --version | head -1) && \
      echo '=====================================================' && \
      apt-get update -y && \
      cd ${GLUTEN_HOME} && \
      export NUM_THREADS=${NUM_THREADS} && \
      export CPU_TARGET=aarch64 && \
      export VELOX_HOME=${VELOX_HOME} && \
      ./dev/buildbundle-veloxbe.sh \
        --spark_version=3.5 \
        --run_setup_script=OFF \
        --build_arrow=OFF && \
      echo '' && \
      echo '=====================================================' && \
      echo ' BUILD COMPLETE! Copying JARs to /output ...' && \
      find ${GLUTEN_HOME}/package/target/ -name '*.jar' \
        ! -name '*sources*' ! -name '*javadoc*' \
        -exec cp -v {} /output/ \\; 2>/dev/null || true && \
      ls -lh /output/*.jar 2>/dev/null || echo 'No JARs found in /output' && \
      echo '=====================================================' \
     "]
